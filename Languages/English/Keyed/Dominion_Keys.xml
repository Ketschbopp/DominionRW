  <Dominion_Setting_ResetDefaults>Reset all settings to defaults</Dominion_Setting_ResetDefaults>

  <Dominion_Setting_SimulationDetail>Simulation detail</Dominion_Setting_SimulationDetail>
  <Dominion_Setting_SimulationDetail_Desc>Lower detail does less work per faction each day. Use Low for worlds with very many factions.</Dominion_Setting_SimulationDetail_Desc>
  <Dominion_SimulationDetail_Low>Low</Dominion_SimulationDetail_Low>
  <Dominion_SimulationDetail_Normal>Normal</Dominion_SimulationDetail_Normal>
