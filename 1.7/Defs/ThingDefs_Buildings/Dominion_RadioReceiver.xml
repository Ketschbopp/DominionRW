<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Dominion_RadioReceiver</defName>
    <rotatable>false</rotatable>
    <label>radio receiver</label>
    <description>A powered receiver with a listening desk. A colonist doing research work can monitor it, which raises your radio coverage. Higher coverage brings news faster and more reliably, and raises your intel on every faction. Coverage fades each day unless someone keeps listening.</description>
    <graphicData>
      <texPath>Things/Building/Dominion_RadioReceiver</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shadowData>
        <volume>(0.6, 0.35, 0.45)</volume>
      </shadowData>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
      </damageData>
    </graphicData>
    <defaultPlacingRot>South</defaultPlacingRot>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.3</fillPercent>
    <pathCost>30</pathCost>
    <castEdgeShadows>true</castEdgeShadows>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>18</Mass>
      <Flammability>0.7</Flammability>
      <Beauty>1</Beauty>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <designationCategory>Misc</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="Dominion.CompProperties_RadioReceiver">
        <coveragePerHour>4</coveragePerHour>
      </li>
    </comps>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Dominion_RadioMonitoring</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>Dominion_LargeRadioAntenna</defName>
    <label>large radio antenna</label>
    <description>A tall, guyed lattice mast with dipoles and a dish. Built right next to a radio receiver (touching it, corners count), it links to the receiver and gives your colony global radio coverage: coverage stays at 100% without anyone monitoring, news by radio arrives within hours, and even lightly guarded traffic can be heard. Both the antenna and the receiver need power.</description>
    <graphicData>
      <texPath>Things/Building/Dominion_LargeRadioAntenna</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.4</fillPercent>
    <castEdgeShadows>false</castEdgeShadows>
    <blockWind>false</blockWind>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0</Flammability>
      <Beauty>-4</Beauty>
    </statBases>
    <costList>
      <Steel>180</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <designationCategory>Misc</designationCategory>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>250</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <researchPrerequisites>
      <li>Dominion_WorldCommsProtocols</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
