<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Dominion_LeadershipDesk</defName>
    <label>leadership desk</label>
    <description>The seat of your government. Your head of state works here on affairs of state, earning the influence that diplomacy costs. Without a desk you can only use simple diplomacy through a comms console.\n\nWood is the basic desk. Steel speeds up the work. Gold speeds it up as well and impresses foreign envoys, making them more likely to accept your proposals.</description>
    <thingClass>Dominion.Building_LeadershipDesk</thingClass>
    <graphicData>
      <texPath>Things/Building/Dominion_LeadershipDesk</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
      <shadowData>
        <volume>(1.8, 0.4, 1.4)</volume>
      </shadowData>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <castEdgeShadows>true</castEdgeShadows>
    <stuffCategories>
      <li>Dominion_DeskMaterials</li>
    </stuffCategories>
    <costStuffCount>150</costStuffCount>
    <costList>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>8</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Wood_Big</destroySound>
    </building>
    <designationCategory>Misc</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
  </ThingDef>
</Defs>
