<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Caravans get extra options on every settlement: diplomatic missions (with an envoy), covert operations and blockades. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/WorldObjectDef[defName="Settlement"]/comps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/WorldObjectDef[defName="Settlement"]/comps</xpath>
      <value>
        <li Class="Dominion.WorldObjectCompProperties_Diplomacy"/>
        <li Class="Dominion.WorldObjectCompProperties_CovertOps"/>
        <li Class="Dominion.WorldObjectCompProperties_Blockade"/>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/WorldObjectDef[defName="Settlement"]</xpath>
      <value>
        <comps>
          <li Class="Dominion.WorldObjectCompProperties_Diplomacy"/>
          <li Class="Dominion.WorldObjectCompProperties_CovertOps"/>
          <li Class="Dominion.WorldObjectCompProperties_Blockade"/>
        </comps>
      </value>
    </nomatch>
  </Operation>
</Patch>
